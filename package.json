{
  "name": "blueprint-plan",
  "version": "1.0.0",
  "private": true,
  "description": "Local-only plan review skill. The runtime (bin/, server/, dist/) uses Node built-ins only; the packages below are build-time inputs that get bundled into dist/.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "checksums": "node scripts/checksums.mjs --write",
    "verify": "node bin/blueprint.mjs verify",
    "test": "node --test test/*.test.mjs",
    "update:deps": "node scripts/update-deps.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  }
}
